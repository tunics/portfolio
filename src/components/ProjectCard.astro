---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
    project: CollectionEntry<'projects'>;
    priority?: boolean;
}

const { project, priority = false } = Astro.props;
const { slug, title, summary, cover, coverAlt } = project.data;
const dialogId = `project-dialog-${slug}`;
const titleId = `project-card-title-${slug}`;
---

<article
    class="project-card"
    aria-labelledby={titleId}
>
    <Image
        src={cover}
        alt={coverAlt}
        class="cover"
        widths={[360, 480, 720, 960, 1440]}
        sizes="(min-width: 1850px) 20vw, (min-width: 1464px) 25vw, (min-width: 1070px) 35vw, (min-width: 768px) 60vw, calc(100vw - 3rem)"
        priority={priority}
    />

    <div class="summary">
        <h3 id={titleId}>{title}</h3>
        <p>{summary}</p>
    </div>

    <button
        type="button"
        class="project-card-trigger"
        data-project-dialog-target={dialogId}
        aria-haspopup="dialog"
        aria-controls={dialogId}
    >
        <span class="visually-hidden">Abrir projeto {title}</span>
    </button>
</article>

<style>
    .project-card {
        margin: 0;
        padding: 0;
        color: inherit;
        background-color: var(--color-surface);
        overflow: hidden;
        position: relative;
        display: block;
        width: 100%;
        text-align: left;
    }

    .project-card-trigger {
        position: absolute;
        inset: 0;
        z-index: 2;
        padding: 0;
        border: 0;
        background: transparent;
        cursor: pointer;
    }

    .project-card-trigger:focus-visible {
        outline: 1px solid var(--color-text);
        outline-offset: -1px;
    }

    .visually-hidden {
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        position: absolute;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
    }

    .cover {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
    }

    .summary {
        width: 100%;
        padding: 1rem;
        position: absolute;
        bottom: 0;
        z-index: 1;
        background-color: var(--color-overlay);
        backdrop-filter: blur(5px) grayscale(100%);
        transform: translateY(100%);
        transition: transform 0.5s ease;
    }

    h3 {
        font-weight: 700;
    }

    p {
        font-size: 1rem;
    }

    .project-card:hover .summary,
    .project-card:focus-within .summary {
        transform: translateY(0);
    }

    @media (hover: none) {
        .summary {
            transform: translateY(0);
        }

        .summary p {
            display: none;
        }
    }

    @media (min-width: 900px) {
        .project-card {
            flex: 0 1 calc(50% - 0.75rem);
        }
    }

    @media (min-width: 1200px) {
        .project-card {
            flex: 0 1 calc(100% / 3 - 1rem);
        }
    }
</style>
