---
import { socialLinks } from '../config/social-links';

interface Props {
    variant?: 'default' | 'menu';
}

const { variant = 'default' } = Astro.props;

---

<div class:list={['social-links', `social-links--${variant}`]}>
    {variant === 'menu' && <hr />}
    {
        socialLinks.map(({ href, label, icon, officialProfile }) => (
            <a
                href={href}
                target="_blank"
                rel={officialProfile
                    ? 'me noopener noreferrer'
                    : 'noopener noreferrer'}
                aria-label={label}
            >
                <img src={icon} alt="" />
            </a>
        ))
    }
</div>

<style>
    .social-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
    }

    .social-links--menu {
        padding: 1rem 3rem;
        gap: 0.5rem;
    }

    hr {
        width: 100%;
    }

    a {
        height: 2rem;
        padding: 0.25rem;
        color: inherit;
        display: flex;
        align-items: center;
        text-decoration: none;
    }

    a:hover,
    a:focus-visible {
        background-color: var(--color-surface);
    }

    a:focus-visible {
        outline: 1px solid var(--color-text);
    }

    img {
        height: 100%;
    }
</style>
