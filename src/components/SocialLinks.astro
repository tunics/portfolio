---
import whatsapp from '../assets/logos/whatsapp.svg?url';
import linkedin from '../assets/logos/linkedin.svg?url';
import behance from '../assets/logos/behance.svg?url';
import github from '../assets/logos/github.svg?url';
import instagram from '../assets/logos/instagram.svg?url';
import fiveHundredPx from '../assets/logos/500px.svg?url';

interface Props {
    variant?: 'default' | 'menu';
}

const { variant = 'default' } = Astro.props;

const socialLinks = [
    { href: 'https://wa.me/5561982282199', label: 'WhatsApp', icon: whatsapp },
    {
        href: 'https://www.linkedin.com/in/antonio-caixeta',
        label: 'LinkedIn',
        icon: linkedin,
    },
    { href: 'https://behance.net/tunics', label: 'Behance', icon: behance },
    { href: 'https://github.com/tunics', label: 'GitHub', icon: github },
    {
        href: 'https://www.instagram.com/tunics/',
        label: 'Instagram',
        icon: instagram,
    },
    { href: 'https://500px.com/tunics', label: '500px', icon: fiveHundredPx },
];
---

<div class:list={['social-links', `social-links--${variant}`]}>
    {variant === 'menu' && <hr />}
    {
        socialLinks.map(({ href, label, icon }) => (
            <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={label}
            >
                <img src={icon} alt="" />
            </a>
        ))
    }
</div>

<style>
    .social-links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem;
    }

    .social-links--menu {
        padding: 1rem 3rem;
        gap: 0.5rem;
    }

    hr {
        width: 100%;
    }

    a {
        height: 2rem;
        padding: 0.25rem;
        color: inherit;
        display: flex;
        align-items: center;
        text-decoration: none;
    }

    a:hover,
    a:focus-visible {
        background-color: var(--color-surface);
    }

    a:focus-visible {
        outline: 1px solid var(--color-text);
    }

    img {
        height: 100%;
    }
</style>
